PORT=3001
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/sigepin
# Como alternativa à URL, use DATABASE_HOST, DATABASE_PORT, DATABASE_NAME,
# DATABASE_USER e DATABASE_PASSWORD.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
FRONTEND_URL=http://localhost:5173
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h
NODE_ENV=development

# E-mail real (Resend). Em desenvolvimento, use console para não enviar mensagens.
EMAIL_PROVIDER=console
EMAIL_FROM=SIEDU <noreply@seudominio.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Primeiro acesso administrativo (usado apenas em npm run db:seed-admin)
ADMIN_NOME=Administrador SIGEPIN
ADMIN_CPF=00000000000
ADMIN_EMAIL=admin@sigepin.local
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha
