# Proteções obrigatórias: o script recusa qualquer outro ambiente ou confirmação.
SIEDU_ENV=homologation
HOMOLOG_RESET_CONFIRMATION=RESETAR_USUARIOS_HOMOLOGACAO

# Somente usuários técnicos já definidos nas migrações do SIEDU.
HOMOLOG_USERS=teste.secretaria.2026,ricardo.diretor.2026

# Defina esta variável como segredo no Railway; nunca grave a senha real neste arquivo.
HOMOLOG_INITIAL_PASSWORD=
